<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily analytics refresh for the 4:00 AM morning brief.

  Runs analytics_report.py (GA4 + Clarity + Search Console) at 3:30 AM so
  reports/latest.html is fresh when the Cowork scheduled brief reads it at 4:00.
  Uses the analytics venv python (has google-analytics-data et al installed).

  Install:
    cp ~/LawFirmWebsite/analytics/com.lotterlaw.analytics-refresh.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.lotterlaw.analytics-refresh.plist

  Logs: ~/LawFirmWebsite/analytics/reports/refresh.log (stdout + stderr)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lotterlaw.analytics-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jefflotter/LawFirmWebsite/analytics/.venv/bin/python</string>
        <string>/Users/jefflotter/LawFirmWebsite/analytics/analytics_report.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jefflotter/LawFirmWebsite/analytics</string>

    <!-- 3:30 AM daily — after the 3:00 Lawmatics/Square sync, before the 4:00 brief -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- If the Mac was asleep at 3:30, run when it wakes -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jefflotter/LawFirmWebsite/analytics/reports/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jefflotter/LawFirmWebsite/analytics/reports/refresh.log</string>
</dict>
</plist>
