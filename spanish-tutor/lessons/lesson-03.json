        "speaker": "B",
        "spanish": "¿Necesito una raqueta especial?",
        "english": "Do I need a special paddle?"
      },
      {
        "speaker": "A",
        "spanish": "No, cualquier raqueta está bien. La pelota es diferente del tenis.",
        "english": "No, any paddle is fine. The ball is different from tennis."
      },
      {
        "speaker": "B",
        "spanish": "Perfecto. ¿Quién va a servir primero?",
        "english": "Perfect. Who is going to serve first?"
      },
